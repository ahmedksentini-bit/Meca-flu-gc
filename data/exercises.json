{
  "version":2,
  "chapters":[
    {"id":"properties","number":1,"title":"Propriétés des fluides","description":"Masse volumique, densité et viscosité."},
    {"id":"hydrostatics","number":2,"title":"Hydrostatique","description":"Pressions et manomètres différentiels."},
    {"id":"forces","number":3,"title":"Poussées hydrostatiques","description":"Résultante et centre de poussée."},
    {"id":"bernoulli","number":4,"title":"Bernoulli et Venturi","description":"Continuité, énergie et débitmétrie."},
    {"id":"momentum","number":5,"title":"Quantité de mouvement","description":"Efforts produits par les jets."},
    {"id":"losses","number":6,"title":"Fluides réels","description":"Darcy-Weisbach, Reynolds et Colebrook."},
    {"id":"similarity","number":7,"title":"Analyse dimensionnelle et similitude","description":"Nombres sans dimension et modèles réduits."},
    {"id":"freeSurface","number":8,"title":"Écoulements à surface libre","description":"Canaux, Froude et Manning-Strickler."}
  ],
  "exercises":[
    {"id":"PROP_VISC_01","chapter":"properties","solver":"viscosity","title":"Viscosité dynamique et cinématique","difficulty":1,"statement":"Une plaque glisse à la vitesse U sur un film de fluide newtonien d’épaisseur e. La force tangentielle F est mesurée sur la surface A. Déterminer la contrainte, la viscosité dynamique puis la viscosité cinématique.","variables":[{"key":"F","label":"Force F","unit":"N","value":12,"min":6,"max":24,"step":1},{"key":"A","label":"Surface A","unit":"m²","value":0.8,"min":0.4,"max":1.2,"step":0.1},{"key":"U","label":"Vitesse U","unit":"m/s","value":0.5,"min":0.2,"max":0.9,"step":0.1},{"key":"e","label":"Épaisseur e","unit":"mm","value":4,"min":2,"max":8,"step":1},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³","value":900,"min":820,"max":1050,"step":10}],"questions":[{"key":"tau","label":"Contrainte tangentielle τ","unit":"Pa"},{"key":"mu","label":"Viscosité dynamique μ","unit":"Pa·s"},{"key":"nu","label":"Viscosité cinématique ν","unit":"m²/s"}]},
    {"id":"HYDRO_MANO_01","chapter":"hydrostatics","solver":"manometer","title":"Manomètre différentiel en U","difficulty":1,"statement":"Deux prises d’une conduite d’eau, situées à la même cote, sont reliées par un manomètre contenant du mercure. Déterminer la différence de pression p₁ − p₂.","variables":[{"key":"h","label":"Dénivellation Δh","unit":"mm","value":120,"min":50,"max":250,"step":10},{"key":"rho","label":"Masse volumique eau","unit":"kg/m³","value":1000,"min":980,"max":1020,"step":5},{"key":"rhoM","label":"Masse volumique Hg","unit":"kg/m³","value":13600,"min":13400,"max":13600,"step":50}],"questions":[{"key":"dp","label":"Différence de pression p₁ − p₂","unit":"Pa"},{"key":"head","label":"Hauteur de pression équivalente","unit":"mCE"}]},
    {"id":"FORCE_PLANE_01","chapter":"forces","solver":"planeForce","title":"Poussée sur une paroi plane verticale","difficulty":2,"statement":"Une vanne rectangulaire verticale de largeur b et de hauteur H affleure la surface libre. Calculer la résultante hydrostatique et la profondeur du centre de poussée.","variables":[{"key":"b","label":"Largeur b","unit":"m","value":2,"min":1,"max":3.5,"step":0.25},{"key":"H","label":"Hauteur H","unit":"m","value":3,"min":1.5,"max":4.5,"step":0.25},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³","value":1000,"min":990,"max":1020,"step":5}],"questions":[{"key":"yc","label":"Profondeur du centre de gravité ȳ","unit":"m"},{"key":"force","label":"Résultante hydrostatique F","unit":"N"},{"key":"yp","label":"Profondeur du centre de poussée yₚ","unit":"m"}]},
    {"id":"BERNOULLI_VENTURI_01","chapter":"bernoulli","solver":"venturi","title":"Débit dans un Venturi horizontal","difficulty":2,"statement":"Un Venturi horizontal est monté sur une conduite d’eau. Un manomètre différentiel au mercure relie l’entrée 1 au col 2. En négligeant les pertes, déterminer le débit et les vitesses.","variables":[{"key":"D1","label":"Diamètre D₁","unit":"mm","value":200,"min":160,"max":300,"step":10},{"key":"D2","label":"Diamètre D₂","unit":"mm","value":100,"min":70,"max":140,"step":5},{"key":"h","label":"Dénivellation Hg","unit":"mm","value":100,"min":50,"max":220,"step":10},{"key":"rho","label":"Masse volumique eau","unit":"kg/m³","value":1000,"min":990,"max":1010,"step":5},{"key":"rhoM","label":"Masse volumique Hg","unit":"kg/m³","value":13600,"min":13400,"max":13600,"step":50}],"questions":[{"key":"S1","label":"Section S₁","unit":"m²"},{"key":"S2","label":"Section S₂","unit":"m²"},{"key":"dp","label":"Différence p₁ − p₂","unit":"Pa"},{"key":"Q","label":"Débit volumique Q","unit":"m³/s"},{"key":"V1","label":"Vitesse V₁","unit":"m/s"},{"key":"V2","label":"Vitesse V₂","unit":"m/s"}]},
    {"id":"MOMENTUM_JET_01","chapter":"momentum","solver":"jetPlate","title":"Jet normal sur une plaque plane","difficulty":2,"statement":"Un jet d’eau horizontal de diamètre d et de vitesse V frappe normalement une plaque fixe puis est dévié tangentiellement. La composante de vitesse suivant le jet devient nulle. Déterminer le débit et l’effort exercé sur la plaque.","variables":[{"key":"d","label":"Diamètre du jet d","unit":"mm","value":50,"min":30,"max":90,"step":5},{"key":"V","label":"Vitesse du jet V","unit":"m/s","value":12,"min":6,"max":20,"step":1},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³","value":1000,"min":990,"max":1010,"step":5}],"questions":[{"key":"area","label":"Section du jet S","unit":"m²"},{"key":"Q","label":"Débit Q","unit":"m³/s"},{"key":"force","label":"Effort du jet F","unit":"N"}]},
    {"id":"LOSSES_COLEBROOK_01","chapter":"losses","solver":"colebrook","title":"Perte de charge — Darcy-Colebrook","difficulty":3,"statement":"De l’eau s’écoule dans une conduite circulaire. Déterminer Reynolds, le facteur de frottement de Darcy par Colebrook-White, puis la perte de charge régulière.","variables":[{"key":"D","label":"Diamètre D","unit":"mm","value":200,"min":100,"max":350,"step":10},{"key":"L","label":"Longueur L","unit":"m","value":300,"min":100,"max":600,"step":25},{"key":"Q","label":"Débit Q","unit":"L/s","value":45,"min":20,"max":90,"step":5},{"key":"eps","label":"Rugosité ε","unit":"mm","value":0.15,"min":0.05,"max":0.5,"step":0.05},{"key":"nu","label":"Viscosité cinématique ν","unit":"10⁻⁶ m²/s","value":1,"min":0.8,"max":1.3,"step":0.1}],"questions":[{"key":"V","label":"Vitesse moyenne V","unit":"m/s"},{"key":"Re","label":"Nombre de Reynolds Re","unit":"—"},{"key":"f","label":"Facteur de Darcy f","unit":"—"},{"key":"hf","label":"Perte de charge h_f","unit":"m"}]},
    {"id":"PROP_DENSITY_01","chapter":"properties","solver":"density","title":"Masse volumique, poids volumique et densité","difficulty":1,"statement":"Un volume d’huile de poids connu est contenu dans un réservoir. Déterminer sa masse, sa masse volumique, son poids volumique et sa densité par rapport à l’eau.","variables":[{"key":"volume","label":"Volume 𝒱","unit":"m³","value":6.5,"min":3,"max":9,"step":0.5},{"key":"W","label":"Poids W","unit":"kN","value":55,"min":25,"max":75,"step":5}],"questions":[{"key":"mass","label":"Masse m","unit":"kg"},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³"},{"key":"gamma","label":"Poids volumique γ","unit":"kN/m³"},{"key":"relative","label":"Densité d","unit":"—"}]},
    {"id":"HYDRO_DEPTH_01","chapter":"hydrostatics","solver":"pressureDepth","title":"Pression d’un plongeur en profondeur","difficulty":1,"statement":"Un plongeur descend à la profondeur h dans l’eau de mer. Déterminer la pression relative puis la pression absolue.","variables":[{"key":"h","label":"Profondeur h","unit":"m","value":28,"min":8,"max":40,"step":2},{"key":"rho","label":"Masse volumique eau de mer","unit":"kg/m³","value":1025,"min":1020,"max":1030,"step":5},{"key":"patm","label":"Pression atmosphérique","unit":"kPa","value":101.3,"min":100,"max":102,"step":0.1}],"questions":[{"key":"relative","label":"Pression relative","unit":"Pa"},{"key":"absolute","label":"Pression absolue","unit":"Pa"}]},
    {"id":"PROP_COMPRESS_01","chapter":"properties","solver":"compressibility","title":"Compressibilité de l’eau","difficulty":2,"statement":"Un volume d’eau initialement à la pression p₁ est comprimé jusqu’à p₂. À l’aide du module d’élasticité volumique K, déterminer la diminution relative et le volume final.","variables":[{"key":"volume","label":"Volume initial","unit":"m³","value":1,"min":0.5,"max":3,"step":0.25},{"key":"p1","label":"Pression p₁","unit":"bar","value":1,"min":1,"max":2,"step":0.1},{"key":"p2","label":"Pression p₂","unit":"bar","value":100,"min":50,"max":250,"step":10},{"key":"K","label":"Module K","unit":"GPa","value":2.2,"min":2.1,"max":2.3,"step":0.05}],"questions":[{"key":"dp","label":"Variation de pression Δp","unit":"Pa"},{"key":"ratio","label":"Diminution relative","unit":"%"},{"key":"deltaV","label":"Diminution de volume |Δ𝒱|","unit":"m³"},{"key":"finalVolume","label":"Volume final 𝒱₂","unit":"m³"}]},
    {"id":"HYDRO_LAYERS_01","chapter":"hydrostatics","solver":"layeredPressure","title":"Réservoir à deux couches","difficulty":2,"statement":"Un réservoir ouvert contient une couche d’huile au-dessus d’une couche d’eau. Déterminer la pression relative à l’interface puis au fond.","variables":[{"key":"hOil","label":"Épaisseur huile","unit":"m","value":2,"min":1,"max":3,"step":0.25},{"key":"rhoOil","label":"Masse volumique huile","unit":"kg/m³","value":850,"min":780,"max":920,"step":10},{"key":"hWater","label":"Épaisseur eau","unit":"m","value":3,"min":1.5,"max":5,"step":0.25},{"key":"rhoWater","label":"Masse volumique eau","unit":"kg/m³","value":1000,"min":990,"max":1010,"step":5}],"questions":[{"key":"interfaceP","label":"Pression à l’interface","unit":"Pa"},{"key":"bottomP","label":"Pression au fond","unit":"Pa"},{"key":"head","label":"Hauteur équivalente","unit":"mCE"}]},
    {"id":"FORCE_GATE_02","chapter":"forces","solver":"submergedGate","title":"Vanne rectangulaire immergée","difficulty":2,"statement":"Une vanne verticale rectangulaire a son arête supérieure à la profondeur y₀. Déterminer la poussée hydrostatique et le centre de poussée.","variables":[{"key":"b","label":"Largeur b","unit":"m","value":2,"min":1,"max":3,"step":0.25},{"key":"H","label":"Hauteur H","unit":"m","value":1.8,"min":1,"max":3,"step":0.2},{"key":"y0","label":"Profondeur arête haute y₀","unit":"m","value":1.2,"min":0.5,"max":3,"step":0.1},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³","value":1000,"min":990,"max":1010,"step":5}],"questions":[{"key":"yc","label":"Profondeur du centre ȳ","unit":"m"},{"key":"force","label":"Poussée F","unit":"N"},{"key":"yp","label":"Centre de poussée yₚ","unit":"m"}]},
    {"id":"BERNOULLI_TORRICELLI_02","chapter":"bernoulli","solver":"torricelli","title":"Vidange par un orifice","difficulty":2,"statement":"Un réservoir de grande section se vide par un orifice circulaire situé sous une charge h. Déterminer la vitesse réelle et le débit avec le coefficient de débit Cᵈ.","variables":[{"key":"d","label":"Diamètre orifice","unit":"mm","value":40,"min":20,"max":80,"step":5},{"key":"h","label":"Charge h","unit":"m","value":6,"min":1,"max":10,"step":0.5},{"key":"Cd","label":"Coefficient Cᵈ","unit":"—","value":0.62,"min":0.58,"max":0.68,"step":0.01}],"questions":[{"key":"area","label":"Section S","unit":"m²"},{"key":"V","label":"Vitesse réelle V","unit":"m/s"},{"key":"Q","label":"Débit Q","unit":"m³/s"}]},
    {"id":"MOMENTUM_DEFLECT_02","chapter":"momentum","solver":"jetDeflect","title":"Jet dévié par un auget fixe","difficulty":2,"statement":"Un jet frappe un auget fixe qui dévie l’écoulement d’un angle θ sans modifier la norme de la vitesse. Déterminer le débit et la résultante exercée sur l’auget.","variables":[{"key":"d","label":"Diamètre jet","unit":"mm","value":50,"min":30,"max":90,"step":5},{"key":"V","label":"Vitesse V","unit":"m/s","value":20,"min":8,"max":25,"step":1},{"key":"theta","label":"Déviation θ","unit":"°","value":135,"min":60,"max":180,"step":15},{"key":"rho","label":"Masse volumique ρ","unit":"kg/m³","value":1000,"min":990,"max":1010,"step":5}],"questions":[{"key":"Q","label":"Débit Q","unit":"m³/s"},{"key":"force","label":"Résultante F","unit":"N"}]},
    {"id":"LOSSES_MINOR_02","chapter":"losses","solver":"minorLosses","title":"Pertes de charge singulières","difficulty":2,"statement":"Une conduite comporte une entrée, plusieurs coudes, une vanne et une sortie. Déterminer la somme des coefficients et la perte de charge singulière totale.","variables":[{"key":"D","label":"Diamètre D","unit":"mm","value":150,"min":100,"max":300,"step":10},{"key":"Q","label":"Débit Q","unit":"L/s","value":30,"min":15,"max":70,"step":5},{"key":"Kentry","label":"K entrée","unit":"—","value":0.5,"min":0.05,"max":0.5,"step":0.05},{"key":"Kelbows","label":"K par coude","unit":"—","value":0.3,"min":0.2,"max":1,"step":0.1},{"key":"nElbows","label":"Nombre de coudes","unit":"—","value":2,"min":1,"max":5,"step":1},{"key":"Kvalve","label":"K vanne","unit":"—","value":0.2,"min":0.1,"max":3,"step":0.1},{"key":"Kexit","label":"K sortie","unit":"—","value":1,"min":1,"max":1,"step":1}],"questions":[{"key":"V","label":"Vitesse V","unit":"m/s"},{"key":"Ksum","label":"Somme ΣK","unit":"—"},{"key":"hf","label":"Perte singulière hₛ","unit":"m"}]},
    {"id":"SIM_FROUDE_01","chapter":"similarity","solver":"froudeSimilarity","title":"Modèle réduit en similitude de Froude","difficulty":2,"statement":"Un modèle hydraulique à surface libre est construit à l’échelle géométrique N = Lprototype/Lmodèle. La vitesse et le débit sont mesurés sur le modèle. Déterminer les valeurs correspondantes en vraie grandeur.","variables":[{"key":"N","label":"Échelle N","unit":"—","value":20,"min":5,"max":50,"step":5},{"key":"Vm","label":"Vitesse modèle","unit":"m/s","value":1.5,"min":0.5,"max":3,"step":0.1},{"key":"Qm","label":"Débit modèle","unit":"L/s","value":12,"min":5,"max":40,"step":1}],"questions":[{"key":"velocityScale","label":"Échelle des vitesses","unit":"—"},{"key":"Vp","label":"Vitesse prototype","unit":"m/s"},{"key":"flowScale","label":"Échelle des débits","unit":"—"},{"key":"Qp","label":"Débit prototype","unit":"m³/s"}]},
    {"id":"CHANNEL_MANNING_01","chapter":"freeSurface","solver":"manningChannel","title":"Canal rectangulaire en régime uniforme","difficulty":3,"statement":"Un canal rectangulaire de largeur b transporte une hauteur d’eau y sous une pente S. En régime uniforme, déterminer le rayon hydraulique, la vitesse et le débit par Manning-Strickler, puis le nombre de Froude.","variables":[{"key":"b","label":"Largeur b","unit":"m","value":3,"min":1.5,"max":6,"step":0.5},{"key":"y","label":"Tirant d’eau y","unit":"m","value":1.2,"min":0.5,"max":2.5,"step":0.1},{"key":"S","label":"Pente S","unit":"‰","value":1.5,"min":0.5,"max":5,"step":0.5},{"key":"Ks","label":"Strickler Kₛ","unit":"m⅓/s","value":70,"min":30,"max":90,"step":5}],"questions":[{"key":"R","label":"Rayon hydraulique R","unit":"m"},{"key":"V","label":"Vitesse moyenne V","unit":"m/s"},{"key":"Q","label":"Débit Q","unit":"m³/s"},{"key":"Fr","label":"Nombre de Froude Fr","unit":"—"}]}
  ]
}
